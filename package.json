{
  "name": "@0xholmes/x402-doctor",
  "version": "0.1.0",
  "description": "Lighthouse for x402 endpoints: probe a paid HTTP endpoint without paying, validate its 402 challenge and on-chain token setup, and score it with a specific fix for every problem.",
  "keywords": [
    "x402",
    "http-402",
    "payment-required",
    "payments",
    "stablecoin",
    "usdc",
    "eip-3009",
    "eip-712",
    "ai-agents",
    "linter",
    "cli",
    "lighthouse"
  ],
  "homepage": "https://github.com/agnij-dutta/x402-doctor#readme",
  "bugs": {
    "url": "https://github.com/agnij-dutta/x402-doctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnij-dutta/x402-doctor.git"
  },
  "license": "MIT",
  "author": {
    "name": "Agnij Dutta",
    "url": "https://x.com/0xholmesdev"
  },
  "type": "module",
  "bin": {
    "x402-doctor": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
