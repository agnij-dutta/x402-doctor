# x402-doctor needs no configuration: it uses keyless public RPCs by default.
# Copy to .env only if you want to override something. Never commit a .env file.

# Override the JSON-RPC URL(s) for a network. Comma-separated for fallbacks, tried in order.
# EVM networks use the chain id:
# X402_DOCTOR_RPC_8453=https://base-mainnet.example/your-key
# X402_DOCTOR_RPC_84532=https://base-sepolia.example/your-key
# Non-EVM networks use the CAIP-2 id upper-cased with non-alphanumerics as "_":
# X402_DOCTOR_RPC_SOLANA_5EYKT4USFV8P8NJDTREPY1VZQKQZKVDP=https://solana-mainnet.example/your-key

# Terminal colors (handled by picocolors): set NO_COLOR=1 to disable, FORCE_COLOR=1 to force.
# NO_COLOR=1
